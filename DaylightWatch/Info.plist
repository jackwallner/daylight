<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
<key>CFBundleName</key><string>Daylight Watch</string>
<key>CFBundleDisplayName</key><string>Daylight</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>ITSAppUsesNonExemptEncryption</key><false/>
<key>NSHealthShareUsageDescription</key><string>Daylight reads Time in Daylight from Apple Health to show your minutes in daylight and the daylight still left today on your wrist.</string>
<key>NSHealthUpdateUsageDescription</key><string>Daylight does not write anything to Apple Health. It only reads Time in Daylight, and this entry is required because the permission sheet asks about reading and writing together.</string>
<key>WKApplication</key><true/>
<key>WKCompanionAppBundleIdentifier</key><string>com.jackwallner.daylight</string>
</dict></plist>
